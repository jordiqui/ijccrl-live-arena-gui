# Required external resources. No engines or opening files are distributed.
IJCCRL_ENGINES=C:/Chess/Engines/EngineA.exe;C:/Chess/Engines/EngineB.exe
IJCCRL_OPENINGS_PGN=C:/Chess/Openings/openings.pgn

# Service
PORT=3012
IJCCRL_EVENT_NAME=IJCCRL Live Arena
IJCCRL_PHASE_NAME=Local Test

# Tournament
IJCCRL_BASE_MS=600000
IJCCRL_INC_MS=2000
IJCCRL_THREADS=1
IJCCRL_HASH_MB=64
IJCCRL_OPENINGS_PLY_LIMIT=16
IJCCRL_OPENINGS_SOURCE_LABEL=Operator-provided opening suite
IJCCRL_PHASE1_OPENINGS_MAX=25
# IJCCRL_PHASE1_GAMES_PER_ENGINE=2
# IJCCRL_PHASE1_WHITE_TARGET=1
# IJCCRL_PHASE1_BLACK_TARGET=1

# Optional Syzygy
# IJCCRL_SYZYGY_PATH=E:/Syzygy
# IJCCRL_SYZYGY_PROBE_LIMIT=6

# WebSocket and chat security
IJCCRL_CHAT_ORIGINS=http://127.0.0.1:3012;http://localhost:3012
# IJCCRL_CHAT_ADMIN_SECRET=replace-with-a-long-random-secret

# Optional support/account subsystem. It remains disabled without a cookie secret.
# IJCCRL_SUPPORT_COOKIE_SECRET=replace-with-a-different-long-random-secret
IJCCRL_SUPPORT_SECURE_COOKIES=false
IJCCRL_SUPPORT_DEV_ECHO_CODES=false
# IJCCRL_SUPPORT_PAYPAL_URL=
# IJCCRL_SUPPORT_HOME_URL=http://127.0.0.1:3012/

# Optional SMTP
IJCCRL_SUPPORT_MAIL_ENABLED=false
# IJCCRL_SUPPORT_MAIL_FROM=
# IJCCRL_SUPPORT_MAIL_REPLY_TO=
# IJCCRL_SUPPORT_SMTP_HOST=
# IJCCRL_SUPPORT_SMTP_PORT=587
# IJCCRL_SUPPORT_SMTP_SECURE=false
# IJCCRL_SUPPORT_SMTP_USER=
# IJCCRL_SUPPORT_SMTP_PASS=

# Diagnostics
IJCCRL_DEBUG=0
IJCCRL_DEBUG_FILE=0
